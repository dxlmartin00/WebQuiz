# Database connection URL
# For local SQLite: "file:./dev.db"
# For production PostgreSQL (Supabase / Neon / Railway / Vercel Postgres):
# DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"
DATABASE_URL="file:./dev.db"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-strong-secret-key-here"

# Developer / System Administrator Email (Automatically approved with Admin privileges)
ADMIN_EMAIL="developer@nemsu.edu.ph"

# Google OAuth 2.0 Credentials (From Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
