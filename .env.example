# Database connection URL
# For TiDB Cloud Starter (MySQL-compatible, 5GB free storage, no pause):
# DATABASE_URL="mysql://username:password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/webquiz?sslaccept=strict"
# For local SQLite: "file:./dev.db"
DATABASE_URL="mysql://username:password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/webquiz?sslaccept=strict"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-strong-secret-key-here"

# Developer / System Administrator Email (Automatically approved with Admin privileges)
ADMIN_EMAIL="developer@nemsu.edu.ph"

# Google OAuth 2.0 Credentials (From Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
